# Environments
.venv/
venv/
*.egg-info/
__pycache__/
*.py[cod]

# Data - never commit. loan.csv is ~1.1 GB and freely downloadable; the
# derived parquet is reproducible from scripts/. Keep the loaders in git,
# not the bytes. Report CSVs under reports/ ARE committed deliberately: they
# are the evidence behind the numbers in the README.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

